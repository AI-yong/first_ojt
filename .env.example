# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 키를 여기에 적지 마세요.

# --- 로컬 모델 서버 ---
LOCAL_API_BASE_URL=http://127.0.0.1:4000/v1
MODEL_NAME=your-tool-calling-model
LOCAL_API_KEY=

# --- 모델 호출 옵션 (기본값으로 충분하면 지워도 됨) ---
REQUEST_TIMEOUT=120
TEMPERATURE=0.2
MAX_TOKENS=1024

# 한 번의 요청에서 Tool 을 연달아 호출할 수 있는 최대 횟수 (무한 루프 방지)
MAX_TOOL_ITERATIONS=12

# Tool 결과를 원래 요청과 대조하고, 안전한 누락만 한 번 자동 보완합니다.
ADAPTIVE_AGENT_MODE=1
MAX_VERIFIER_RETRIES=1

# 사용자가 명시적으로 기억을 요청한 쇼핑 선호를 세션에 저장합니다.
USER_MEMORY_ENABLED=1

# 의미 검색 코사인 유사도 하한. 사람 평가 후 이 값만 조정합니다.
SEMANTIC_MIN_SCORE=0.40

# --- 서버별 추가 파라미터 (JSON) ---
# 요청 본문에 그대로 합쳐집니다. 서버가 표준 외 옵션을 요구할 때 씁니다.
# 사용하는 서버가 표준 외 옵션을 요구할 때만 설정합니다.
EXTRA_BODY={}

# 서버가 tool_calls 필드를 지원하지 않아 본문 텍스트에서 Tool 호출을 읽어야 할 때만 1 로 켭니다.
# 기본은 꺼짐. 켜면 모델이 설명으로 적은 JSON 까지 실행될 위험이 있으므로,
# 켜더라도 <tool_call>...</tool_call> 로 감싼 것만 인정합니다.
ALLOW_TEXT_TOOL_CALLS=0

# 되돌릴 수 없는 작업의 승인을 화면 버튼으로만 받습니다. 기본 켜짐.
# 0 으로 끄면 모델이 사용자의 말을 읽고 승인 여부를 판단하는 예전 방식이 됩니다.
APPROVE_BY_BUTTON=1

# 승인 버튼 유효 시간(초). 지나면 대기 작업과 연결된 후속 작업을 모두 폐기합니다.
PENDING_TTL_SECONDS=300
EMBED_BACKEND=st
EMBED_MODEL_NAME=jhgan/ko-sroberta-multitask

# Dense 임계값을 통과한 최대 50개를 cross-encoder로 재정렬합니다.
RERANK_ENABLED=1
RERANK_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_MODEL_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RERANK_BATCH_SIZE=16

# 확인 버튼 직전 검증(이번 턴에 실패한 Tool 이 있을 때만). 1 켬 / 0 끔
VERIFY_BEFORE_CONFIRM=1
